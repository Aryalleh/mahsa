# ─────────────────────────────────────────────────────────────
# Mahsa configuration — copy to `.env` and fill in your values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ---- Telegram (get api_id / api_hash from https://my.telegram.org) ----
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
# The real phone number the user account logs in with (international format)
TELEGRAM_PHONE=+15551234567
# Telethon session name (a <name>.session file is created next to it)
TELEGRAM_SESSION=sessions/mahsa

# Channel where the daily emotional posts are published.
# Use @username or a numeric -100... id. Mahsa's account must be an admin.
TELEGRAM_CHANNEL=@my_channel

# Comma-separated Telegram user ids allowed to run admin commands
# (e.g. /teach, /post, /mood). Leave empty to allow no one.
ADMIN_USER_IDS=

# Whitelist mode: when true, Mahsa only chats with admin-approved contacts.
# The first time someone new messages her, the admin(s) are asked to
# /approve or /block them. Strongly recommended to keep this on.
WHITELIST_ENABLED=true

# Group chat: when true, Mahsa replies in groups she's in when she is replied to,
# @mentioned, or called by name. Approved friends get her warm/relaxed tone;
# strangers get the lighter public tone.
GROUP_CHAT_ENABLED=true

# ---- Local LLM ----
# Path to the downloaded GGUF weights.
LLM_MODEL_PATH=models/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# Context window (tokens). 8192 is a safe default for this model.
LLM_CONTEXT=8192
# Number of layers to offload to GPU. 0 = CPU only, -1 = all layers.
LLM_GPU_LAYERS=0
# Sampling
LLM_TEMPERATURE=0.75
# Kept small so chat replies stay short and human. Raise for longer messages.
LLM_MAX_TOKENS=160

# ---- Persona ----
PERSONA_FILE=src/persona/mahsa.yaml

# ---- Daily post schedule (24h local time) ----
DAILY_POST_HOUR=21
DAILY_POST_MINUTE=0
# Set to false to disable automatic daily posting
DAILY_POST_ENABLED=true

# ---- Following joined channels ----
# When on, Mahsa watches new posts in channels her account has joined; on some
# of them she adds an emoji reaction and (if the channel has comments open)
# comments the "vibe" she got, in her own voice.
# WARNING: reacting/commenting on lots of posts is very bot-like and risks the
# account being limited. Keep this off unless you want it, and keep the chance low.
CHANNEL_WATCH_ENABLED=false
CHANNEL_REACT=true
CHANNEL_COMMENT=true
# Probability (0..1) she acts on any given post — keep it well below 1 to look human.
CHANNEL_ACTION_CHANCE=0.6
# Skip posts shorter than this many characters (stickers, one-word posts, etc.)
CHANNEL_MIN_LEN=15
# She waits a random 0..N seconds before acting, so it isn't instant/robotic.
CHANNEL_MAX_DELAY=45

# ---- Storage ----
DATABASE_PATH=data/mahsa.db

# ---- Behaviour ----
# Max recent turns kept in a conversation before older ones are summarised out.
MEMORY_MAX_TURNS=20
